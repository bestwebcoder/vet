# Local development points at the Supabase stack started by `npm run db:start`.
# `supabase start` prints these values; they are the same on every machine.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never expose to the browser and
# never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Notification delivery (Phase 9). All optional — an unconfigured channel
# degrades to the safe logging provider (see
# src/lib/notifications/providers/logging.ts) instead of failing to start.
# Locally, point SMTP at the Supabase Mailpit stack (npm run db:start) and
# generate a VAPID pair with `npx web-push generate-vapid-keys`.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM="The Traveling Vet <no-reply@thetravelingvet.local>"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thetravelingvet.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NOTIFICATION_CRON_SECRET=
